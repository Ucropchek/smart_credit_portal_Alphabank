# Local PostgreSQL for the ML package only. Copy to src/ml/.env (not committed).
# Placeholders, not production credentials.
ML_POSTGRES_HOST=localhost
ML_POSTGRES_PORT=5432
ML_POSTGRES_USER=ml
ML_POSTGRES_PASSWORD=change-me
ML_POSTGRES_DB=ml
# Directory of *.sql scripts. Relative paths are resolved from the current directory.
ML_SQL_DIR=sql
