# Reference for ML_POSTGRES_* values used by Compose and the Python package.
# Compose reads the repo-root `.env` (or shell exports), not this file path.
# `main.py` reads process environment only (no dotenv / no src/ml/.env).
# Placeholders, not production credentials. Password may stay `change-me` locally.
ML_POSTGRES_HOST=localhost
ML_POSTGRES_PORT=5432
ML_POSTGRES_USER=ml
ML_POSTGRES_PASSWORD=change-me
ML_POSTGRES_DB=ml
# Optional. When unset, sql/ under the ML package root is auto-discovered.
# Relative values resolve against the package root (src/ml), not the process cwd.
# ML_SQL_DIR=sql

# Product search. Defaults suit a local run; Compose sets the service names instead of localhost.
ML_SEARXNG_URL=http://localhost:8888
ML_OLLAMA_URL=http://localhost:11434
# Open-weight Qwen 3.5 from the Ollama library. qwen3.5:9b reads Russian pages better, needs ~7 GB.
ML_LLM_MODEL=qwen3.5:4b
# Optional tuning.
# ML_LLM_TIMEOUT=180
# ML_SEARCH_MAX_QUERIES=3
# ML_SEARCH_RESULTS_PER_QUERY=8
# ML_SEARCH_MAX_CANDIDATES=16
# ML_FETCH_TIMEOUT=8
# ML_FETCH_CONCURRENCY=5
# Handoff from the backend (POST /). Jobs live in database ml; "memory" keeps them in process only.
# ML_GOODS_STORE=postgres
# ML_HANDOFF_MAX_CATEGORIES=3
