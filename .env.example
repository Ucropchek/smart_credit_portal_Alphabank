# Copy to `.env` next to docker-compose.yml to change these values. Every one has a default, so `.env` is optional.
# Placeholders only — no secrets.
ML_POSTGRES_USER=ml
ML_POSTGRES_PASSWORD=change-me
ML_POSTGRES_DB=ml

# Open-weight model for the goods search. qwen3.5:9b reads Russian pages better but needs ~7 GB.
ML_LLM_MODEL=qwen3.5:4b

# Ports published on the host.
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000
